# Variáveis para o deploy em VPS (docker-compose.prod.yml).
# Copie para .env e preencha. NUNCA versione o .env real.

# Banco (usado pelo container Postgres)
POSTGRES_USER=saldo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=saldo

# URL pública do frontend (para CORS). Ex.: http://SEU_IP  ou  https://seu-dominio.com
WEB_ORIGIN=http://localhost

# URL pública da API (embutida no build do frontend). Ex.: http://SEU_IP:3333
VITE_API_URL=http://localhost:3333

# Segredos JWT — gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=coloque-um-segredo-forte-aqui
JWT_REFRESH_SECRET=coloque-outro-segredo-forte-aqui
