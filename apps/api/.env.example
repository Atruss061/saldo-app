# Banco de dados (Postgres via docker-compose)
DATABASE_URL="postgresql://saldo:saldo@localhost:5432/saldo?schema=public"

# Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
# Origem(ns) do frontend (CORS). Uma URL, ou várias separadas por vírgula.
WEB_ORIGIN=http://localhost:5173
# (Opcional) Regex para liberar URLs de preview no CORS.
# Ex.: para previews da Vercel do projeto "saldo":
# PREVIEW_ORIGIN_REGEX=^https://saldo-.*\.vercel\.app$

# Autenticação — TROQUE estes segredos em produção (use `openssl rand -base64 48`)
JWT_ACCESS_SECRET="troque-este-segredo-de-access-token"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-token"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
